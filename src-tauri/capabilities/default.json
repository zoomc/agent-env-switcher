{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-app-read-recursive",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-app-write-recursive",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCONFIG/**" }]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.hermes/**" },
        { "path": "$HOME/.openclaw/**" },
        { "path": "$HOME/.codex/**" }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.hermes/**" },
        { "path": "$HOME/.openclaw/**" },
        { "path": "$HOME/.codex/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.hermes/**" },
        { "path": "$HOME/.openclaw/**" },
        { "path": "$HOME/.codex/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.hermes/**" },
        { "path": "$HOME/.openclaw/**" },
        { "path": "$HOME/.codex/**" }
      ]
    }
  ]
}
